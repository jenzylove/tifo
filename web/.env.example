# Tifo environment variables

# Network: testnet or mainnet
NEXT_PUBLIC_NETWORK=testnet

# TifoFactory contract address
NEXT_PUBLIC_FACTORY=

# Deploy block for the factory (for indexing)
NEXT_PUBLIC_FACTORY_BLOCK=

# Circle client key for the public app (passkey wallets and checkout)
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=

# Optional: public RPC override for Arc reads
NEXT_PUBLIC_ARC_RPC_URL=

# Optional: public site URL for OG tags in share cards
NEXT_PUBLIC_SITE_URL=

# Optional: server only node URL for Arc writes, takes precedence over NEXT_PUBLIC_ARC_RPC_URL (secret)
ARC_RPC_URL=

# Secret: private key of the agent wallet that sizes budgets, picks matches and settles results
AGENT_PRIVATE_KEY=

# Secret: Anthropic API key for the agent's Claude calls
ANTHROPIC_API_KEY=

# Secret: token for the /api/tick endpoint that settles matches (schedule with GitHub Actions)
TICK_SECRET=

# Secret: key that seals digital deliveries (/api/seal) and opens them for paid orders (/api/unlock) (min 32 chars, use a strong random string)
DELIVERY_SECRET=

# Secret: Vercel Blob token for image uploads (seller product photos and share cards)
BLOB_READ_WRITE_TOKEN=

# Practice version (the same app on Arc testnet). On the real site, set these to list its drops under the real ones.
NEXT_PUBLIC_PRACTICE_URL=
NEXT_PUBLIC_PRACTICE_FACTORY=
# On the practice site, the real site's URL for the "Go to the real site" link.
NEXT_PUBLIC_MAIN_URL=

# Pay in naira through Bachs. Off until the key, the rate and the float address are all set.
# Secret: Bachs secret key (sk_sandbox_... to test, sk_live_... for real money; the prefix picks the API)
BACHS_SECRET_KEY=
# Secret: signing secret of the Bachs webhook endpoint that points at /api/naira/webhook (events collection.succeeded and checkout.completed)
BACHS_WEBHOOK_SECRET=
# Naira per 1 USD, for example 1550. Buyers pay this rate, rounded up to the next 10 naira
NAIRA_PER_USD=
# Address of the TifoFloat contract holding the USDC that is sold for naira (its releaser must be the agent wallet)
NAIRA_FLOAT=
# Optional: the most USD one naira payment may buy, default 50
NAIRA_MAX_USD=

# Pay in naira with no wallet (a WhatsApp number instead). Needs the naira settings above and BLOB_READ_WRITE_TOKEN.
# Secret, server only, at least 32 characters: each guest buyer's key is derived from it and their phone number.
# NEVER change or lose it once guests have paid: their money back sits at addresses only this secret can reach.
GUEST_SECRET=
# Optional: USDC sent with each guest order for gas on Arc, in dollars, default 0.05 (the buyer pays it in the naira price)
GUEST_GAS_USD=
# Optional: set to 1 to let guest buyers collect money back to a Nigerian bank (Bachs payouts; the key needs payouts:write
# and payouts:read). Off, or without that scope, the money stays held at the buyer's number and the page says so.
NAIRA_PAYOUTS=

# Optional: drops or seller addresses to take off the site and out of the agent's work (spam, a shop pretending to be
# someone else). Comma separated. Their contracts still let anyone settle them and every buyer claim what they are owed.
HIDDEN_DROPS=

# Optional, server only: the operator's own wallets, comma separated. Drops they sell and orders they place are left out
# of every number on /proof, /agent and the home page (our own testing is not usage). Include every wallet used to test.
SELF_WALLETS=

# Optional: the most Claude backed calls (chat, plan, import, brief) the whole site allows per day, default 1500
CLAUDE_DAILY_CAP=
